# ===== Servidor =====
PORT=4000
NODE_ENV=development
# URL del frontend (CORS y enlaces del ticket QR)
FRONTEND_URL=http://localhost:5173

# ===== Base de datos PostgreSQL =====
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/smartpark
# En Railway/Render con SSL poner true
DB_SSL=false

# ===== Seguridad =====
# Cambiar por una cadena larga y aleatoria. NUNCA subirla a GitHub.
JWT_SECRET=cambia_esta_clave_por_una_muy_larga_y_aleatoria
JWT_EXPIRES_IN=8h

# ===== Zona horaria del negocio =====
TZ_NEGOCIO=America/Guayaquil

# ===== Reconocimiento de placas (Plate Recognizer) =====
# Crear cuenta gratuita en https://platerecognizer.com y copiar el token.
# Si se deja vacío, el guardia ingresa la placa manualmente.
PLATE_RECOGNIZER_TOKEN=
PLATE_RECOGNIZER_REGIONS=
